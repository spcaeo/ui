{
  "name": "@spcaeo/ui",
  "version": "1.0.0",
  "private": true,
  "description": "UI components built to a measured bar: every colour measured from the stylesheet, every behavioural claim covered by a browser test, and both enforced in CI.",
  "license": "MIT",
  "author": "Space-O Technologies (https://www.spaceo.ca)",
  "type": "module",
  "homepage": "https://spcaeo.github.io/ui/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spcaeo/ui.git"
  },
  "bugs": {
    "url": "https://github.com/spcaeo/ui/issues"
  },
  "workspaces": [
    "components/*"
  ],
  "scripts": {
    "contrast": "node tools/contrast.mjs",
    "contrast:sync": "node tools/contrast.mjs --sync",
    "contrast:check": "node tools/contrast.mjs --check",
    "build:demo": "node tools/build-demo.mjs",
    "check:demo": "node tools/build-demo.mjs --check",
    "test": "node tools/smoke-test.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "check": "npm run contrast:check && npm run check:demo && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "npx --yes serve@14 . -l 4321",
    "docs:dev": "npm --prefix docs run docs:dev",
    "docs:build": "npm --prefix docs run docs:build"
  },
  "devDependencies": {
    "playwright": "1.49.1",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=18"
  }
}
