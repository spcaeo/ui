{
  "name": "vb-inspired-folder-tabs",
  "version": "1.0.0",
  "description": "A tab control where the active tab IS the panel, not a highlighted button. Inspired by the Visual Basic 4 SSTab control. Zero dependencies, React and vanilla builds, one stylesheet between them.",
  "keywords": [
    "tabs",
    "tab-control",
    "folder-tabs",
    "sstab",
    "visual-basic",
    "vb4",
    "vb6",
    "retro-ui",
    "css",
    "react",
    "radix-ui",
    "accessibility",
    "wcag",
    "aria",
    "dark-mode",
    "oklch",
    "no-build",
    "ui-component"
  ],
  "license": "MIT",
  "author": "spcaeo",
  "homepage": "https://spcaeo.github.io/vb-inspired-folder-tabs/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spcaeo/vb-inspired-folder-tabs.git"
  },
  "bugs": {
    "url": "https://github.com/spcaeo/vb-inspired-folder-tabs/issues"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./vanilla/folder-tabs.js",
    "./react": "./react/folder-tabs.tsx",
    "./folder-tabs.css": "./folder-tabs.css",
    "./package.json": "./package.json"
  },
  "files": [
    "folder-tabs.css",
    "react/folder-tabs.tsx",
    "vanilla/folder-tabs.js",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "contrast": "node tools/contrast.mjs",
    "contrast:check": "node tools/contrast.mjs --check && node tools/contrast.mjs --sync-check",
    "build:demo": "node tools/build-demo.mjs",
    "check:demo": "node tools/build-demo.mjs --check",
    "check": "npm run contrast:check && npm run check:demo && npm run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "demo": "npx --yes serve@14 . -l 4321",
    "docs:dev": "npm --prefix docs run docs:dev",
    "docs:build": "npm --prefix docs run docs:build",
    "test": "node tools/smoke-test.mjs",
    "screenshots": "node tools/screenshots.mjs",
    "contrast:sync": "node tools/contrast.mjs --sync"
  },
  "peerDependencies": {
    "@radix-ui/react-tabs": ">=1.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@radix-ui/react-tabs": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "prettier": "^3.4.2"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module"
}
